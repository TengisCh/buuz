{
  "name": "buuz-site",
  "private": true,
  "version": "0.1.0",
  "description": "Buuz 2.0 web converter: type Latin, get Mongolian Cyrillic",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "bash scripts/build-wasm.sh",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@types/node": "^22.20.5",
    "typescript": "5.7.3",
    "vite": "6.4.5"
  }
}
