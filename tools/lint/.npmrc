# Supply-chain guard (npm 11.10+; older npm ignores it).
# Never resolve a version published less than 7 days ago. Fresh releases are
# where hijacked packages live; most are yanked within days.
# One-off bypass for an urgent security fix: npm install <pkg> --min-release-age=0
min-release-age=7
# Pin what we add, so package.json says exactly what the lockfile holds.
save-exact=true
