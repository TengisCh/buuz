{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "autoCompactWindow": 400000,
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(npm ci *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm audit *)",
      "Bash(npm ls *)",
      "Bash(tools/lint/node_modules/.bin/markdownlint-cli2 *)",
      "Bash(tools/lint/node_modules/.bin/markdownlint-cli2)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(cargo doc *)",
      "Bash(gh label list *)",
      "Bash(gh pr list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git pull *)",
      "Bash(git pull)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git push)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr status *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(export PATH=*)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm update *)",
      "Bash(npx *)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(cargo update *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(npm publish *)",
      "Bash(cargo publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(vercel env *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --set-upstream origin main*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-rust.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-routing.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-focus.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
