# Turn the two string tables into one C++ file. Run with
#   cmake -DMN=<strings_mn.tsv> -DEN=<strings_en.tsv> -DOUT=<file.cpp> -P cmake_strings.cmake
file(READ "${MN}" _mn)
file(READ "${EN}" _en)
file(WRITE "${OUT}"
"// Generated by cmake_strings.cmake. Do not edit.
#include \"strings_data.h\"
namespace buuz {
const char* const kStringsMn = R\"BUUZSTR(${_mn})BUUZSTR\";
const char* const kStringsEn = R\"BUUZSTR(${_en})BUUZSTR\";
}  // namespace buuz
")
